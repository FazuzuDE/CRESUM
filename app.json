{
  "expo": {
    "name": "CRESUM",
    "slug": "cresum",
    "version": "0.1.14",
    "orientation": "portrait",
    "scheme": ["cresum", "fitflow"],
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow CRESUM to scan workout plan QR codes.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fitflow.app"
    },
    "android": {
      "package": "com.fitflow.app"
    }
  }
}
