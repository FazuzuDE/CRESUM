{
  "expo": {
    "name": "CRESUM",
    "slug": "cresum",
    "version": "0.3.38",
    "orientation": "portrait",
    "scheme": ["cresum", "fitflow"],
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow CRESUM to scan workout plan QR codes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fitflow.app",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.fitflow.app"
    },
    "locales": {
      "nb": "./lib/i18n/locales/nb/native.json",
      "fi": "./lib/i18n/locales/fi/native.json"
    }
  }
}
