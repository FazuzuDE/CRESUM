{
  "name": "cresum",
  "version": "0.1.36",
  "private": true,
  "engines": {
    "node": ">=22.16.0 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.2",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "config:check": "node scripts/check-config.cjs && expo config --type public",
    "deps:check": "expo install --check",
    "check": "npm run version:check && npm run typecheck && npm run lint && npm run format:check && npm run anatomy:check && npm run i18n:check && npm test && npm run config:check && npm run deps:check",
    "i18n:check": "node scripts/build-sharing-catalog.cjs --check && node scripts/build-catalog-labels.cjs --check && node scripts/build-technique-messages.cjs --check && node scripts/check-localization.cjs",
    "i18n:report": "node scripts/check-localization.cjs --report",
    "anatomy:check": "node scripts/build-anatomical-muscle-map.cjs --check",
    "export:check": "expo export --platform ios --platform android",
    "i18n:web:qa": "expo export --platform web --output-dir .tools/localization-web-export && node scripts/localization-web-qa.cjs --export-dir .tools/localization-web-export",
    "version:pr": "node scripts/pr-version.cjs",
    "version:check": "node scripts/pr-version.cjs --check"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.117.2",
    "expo": "~57.0.31",
    "expo-asset": "~57.0.20",
    "expo-blur": "~57.0.3",
    "expo-camera": "57.0.6",
    "expo-clipboard": "57.0.2",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.29",
    "expo-sharing": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "i18next": "26.5.4",
    "intl-pluralrules": "2.0.1",
    "qrcode-generator": "2.0.4",
    "query-string": "^7.1.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "4.0.0",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.13",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "prettier": "^3.9.8",
    "react-dom": "19.2.3",
    "typescript": "~6.0.3"
  }
}
