{
  "name": "cresum",
  "version": "0.2.74",
  "private": true,
  "engines": {
    "node": ">=22.16.0 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.2",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "config:check": "node scripts/check-config.cjs && expo config --type public",
    "deps:check": "expo install --check",
    "check": "npm run version:check && npm run typecheck && npm run lint && npm run format:check && npm run anatomy:check && npm run i18n:check && npm test && npm run config:check && npm run deps:check",
    "i18n:check": "node scripts/build-sharing-catalog.cjs --check && node scripts/build-catalog-labels.cjs --check && node scripts/build-technique-messages.cjs --check && node scripts/check-localization.cjs",
    "i18n:report": "node scripts/check-localization.cjs --report",
    "anatomy:check": "node scripts/build-anatomical-muscle-map.cjs --check",
    "export:check": "expo export --platform ios --platform android",
    "i18n:web:qa": "expo export --platform web --output-dir .tools/localization-web-export && node scripts/localization-web-qa.cjs --export-dir .tools/localization-web-export",
    "version:pr": "node scripts/pr-version.cjs",
    "version:check": "node scripts/pr-version.cjs --check"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.1",
    "@supabase/supabase-js": "2.117.2",
    "expo": "~58.0.25",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-blur": "~58.0.6",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.31",
    "expo-sharing": "~58.0.23",
    "expo-status-bar": "~58.0.5",
    "i18next": "26.5.4",
    "intl-pluralrules": "2.0.1",
    "qrcode-generator": "2.0.4",
    "query-string": "^7.1.3",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "4.0.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "prettier": "^3.9.8",
    "react-dom": "19.3.0",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  }
}
